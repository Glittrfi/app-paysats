# Privy (wajib untuk auth)
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Database
DATABASE_URL="file:./prisma/dev.db"

# Enkripsi kredensial per-user (64 karakter hex)
ENCRYPTION_KEY=

# IDRX API organisasi
IDRX_API_BASE_URL=
IDRX_ORG_API_KEY=
IDRX_ORG_API_SECRET=

# Token IDRX on-chain (Base default ada di kode; override jika perlu)
NEXT_PUBLIC_IDRX_TOKEN_ADDRESS=
IDRX_TOKEN_ADDRESS=

# Chain — Base mainnet
NEXT_PUBLIC_DEFAULT_CHAIN_ID=8453
BASE_RPC_URL=
NEXT_PUBLIC_BASE_RPC_URL=

# Token BTC terbungkus di Base (cbBTC) — opsional; untuk tab saldo BTC.
# Hanya satu alamat (42 char). Contoh Base mainnet:
# NEXT_PUBLIC_BTC_ERC20_ADDRESS=0xcbB7C0000aB88B473b1f5aFd9ef808440eed33Bf
NEXT_PUBLIC_BTC_ERC20_ADDRESS=

# --- Stacks pilot (Stacks Endowment grant) ----------------------------------
# Network for the Stacks pilot: "mainnet" | "testnet". Wallet connect and
# balance reads work on both; Bitflow swap + DCA are mainnet-only.
NEXT_PUBLIC_STACKS_NETWORK=mainnet

# PaySats-owned Stacks address that holds prepaid USDCx and broadcasts
# Bitflow swaps / sBTC payouts. Safe to expose — users transfer to it.
# Fund this address with STX for gas.
NEXT_PUBLIC_STACKS_KEEPER_ADDRESS=
# Server-only hex private key for that address (64 hex chars, optional 01 suffix).
STACKS_KEEPER_PRIVATE_KEY=
# Bearer secret for POST/GET /api/stacks/dca/execute (cron or curl). Min 16 chars.
STACKS_DCA_CRON_SECRET=
# Optional. Self-hosted worker URL (default http://127.0.0.1:3000/api/stacks/dca/execute).
# Production (pm2 / next start on port 3400):
# DCA_CRON_URL=http://127.0.0.1:3400/api/stacks/dca/execute

# Optional Hiro Platform API key (x-api-key). Without it, public Hiro limits
# are ~50 RPM/IP and /stacks can 429 under balance probes.
# Create free at https://platform.hiro.so — raise limit to ~500 RPM.
# HIRO_API_KEY=

# Optional Bitflow API keys (public rate limit is 500 req/min/IP without them).
# BITFLOW_API_KEY=
# READONLY_CALL_API_KEY=
# KEEPER_API_KEY=

# Optional host overrides (working defaults are baked into lib/stacks/config.ts).
# NEXT_PUBLIC_BITFLOW_API_HOST=https://bitflow-sdk-api-gateway-7owjsmt8.uc.gateway.dev
# NEXT_PUBLIC_KEEPER_API_HOST=https://keeper.bitflowapis.finance
# NEXT_PUBLIC_READONLY_CALL_API_HOST=https://api.hiro.so
# BITFLOW_PROVIDER_ADDRESS=SP3MCM8K9KEJMFM6MN191JVN5CA51MDS7AM3SGYQ6

# --- MCP agent (Claude) -----------------------------------------------------
# Auth model: Privy OAuth 2.0 Device Authorization Grant ("Authorized wallet
# access for self-hosted agents"). Enable it in the Privy Dashboard
# (Authentication -> Advanced -> Enable for CLI and agent access) and set the
# Verification URI to the hosted approval page below. The MCP server obtains a
# per-user access token (used as a user_jwt to sign wallet RPC) — no static
# authorization key or session-signer policy is needed.

# Base URL of the hosted Verification page (also set as the Privy Verification
# URI, with the /verification path). Used as a fallback if Privy does not return
# verification_uri_complete.
VERIFICATION_BASE_URL=https://app.paysats.exchange

# --- Deprecated (previous session-signer model; no longer used) -------------
# PRIVY_AUTHORIZATION_KEY=
# PRIVY_AGENT_SIGNER_ID=
# NEXT_PUBLIC_PRIVY_AGENT_SIGNER_ID=
# PRIVY_AGENT_POLICY_ID=
# NEXT_PUBLIC_PRIVY_AGENT_POLICY_ID=
